@startuml
!include ../../_style.puml
title ИС библиотеки: модель предметной области
hide circle

package "catalog" {
  class Книга {
    + isbn : String
    + название : String
    - год : int
  }
  class Автор {
    + фио : String
  }
  class Экземпляр {
    + инвентарныйНомер : String
    + состояние : Состояние
  }
  enum Состояние {
    НОВЫЙ
    ХОРОШЕЕ
    ТРЕБУЕТ_РЕМОНТА
    СПИСАН
  }
  class ИмпортБиблиографии {
    + дата : DateTime
    + источник : String
    + статус : СтатусИмпорта
  }
  enum СтатусИмпорта {
    ЗАПУЩЕН
    ЗАВЕРШЁН
    ОШИБКА
  }
}

package "circulation" {
  abstract class Читатель {
    + фио : String
    + билет : String
    {abstract} + лимитКниг() : int
    {abstract} + ставкаПени() : Money
  }
  class Студент
  class Преподаватель
  class Выдача {
    + датаВыдачи : Date
    + датаВозврата : Date
    + просрочена() : boolean
  }
  class Бронь {
    + датаНачала : DateTime
    + датаОкончания : DateTime
  }
  class Пеня {
    + сумма : Money
    + датаНачисления : Date
    + оплачена : boolean
  }
  class ПолитикаВыдачи {
    + лимитСтудента : int
    + лимитПреподавателя : int
    + ставкаПениСтудента : Money
    + ставкаПениПреподавателя : Money
    + рассчитатьПеню(выдача : Выдача) : Money
  }
  class Списание {
    + дата : Date
    + причина : String
  }
}

Студент --|> Читатель
Преподаватель --|> Читатель

Книга "1" *-- "0..*" Экземпляр
Книга "1" -- "0..*" Автор
Экземпляр "1" -- "0..*" Выдача
Экземпляр "1" -- "0..*" Бронь
Читатель "1" -- "0..*" Выдача
Читатель "1" -- "0..*" Бронь
Выдача "1" -- "0..1" Пеня
Экземпляр "1" -- "0..*" Списание
ИмпортБиблиографии "1" -- "0..*" Книга

circulation ..> catalog : <<use>>
ПолитикаВыдачи ..> Выдача : <<use>>
@enduml