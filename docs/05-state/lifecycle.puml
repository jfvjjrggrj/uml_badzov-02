@startuml
!include ../../_style.puml
title Жизненный цикл «Экземпляр»

hide empty description

state НОВЫЙ
state ХОРОШЕЕ
state НА_РУКАХ
state УТЕРЯН
state СПИСАН

state РЕМОНТ {
  state ТРЕБУЕТ_РЕМОНТА
  state В_РЕМОНТЕ
  [*] --> ТРЕБУЕТ_РЕМОНТА
  ТРЕБУЕТ_РЕМОНТА --> В_РЕМОНТЕ : отправитьВРемонт()
  В_РЕМОНТЕ --> [*]
}

[*] --> НОВЫЙ : поставитьНаУчёт()
НОВЫЙ : entry / присвоитьИнвентарныйНомер()
НОВЫЙ --> ХОРОШЕЕ : разместитьВФонде()

ХОРОШЕЕ --> НА_РУКАХ : выдать() [нет активной брони]
НА_РУКАХ --> ХОРОШЕЕ : принятьВозврат() [состояние удовлетворительное]
НА_РУКАХ --> РЕМОНТ : принятьВозврат() [повреждён]

РЕМОНТ --> ХОРОШЕЕ : вернутьИзРемонта()
РЕМОНТ --> СПИСАН : признатьНепригодным()
РЕМОНТ --> СПИСАН : after(30 дней) / списатьПоТаймауту()

ХОРОШЕЕ --> УТЕРЯН : отметитьУтерю()
ХОРОШЕЕ --> СПИСАН : списать() [устарел]

УТЕРЯН --> [*]
СПИСАН --> [*]
@enduml